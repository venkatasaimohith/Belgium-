# Legacy example. New installations should use ../.env.example at project root.
GOOGLE_MAPS_API_KEY=
MAILBOX_MAX_SITES=0
MAILBOX_ENHANCEMENT_FP16=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2-vl
PREFER_LIVE_CADGIS=false

# External API response cache (30 days by default)
DATABASE_URL=postgresql://mailbox:mailbox_cache@127.0.0.1:15432/mailbox_cache
REDIS_URL=redis://127.0.0.1:16379/0
API_CACHE_TTL_SECONDS=2592000

# Network access
PORT=8002
BIND_HOST=0.0.0.0
# Optional: force the URL hostname shown to clients (e.g. office DNS name)
# PUBLIC_HOST=mailbox-studio.local

