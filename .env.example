# Mailbox Detection Studio - central application and Docker configuration
GOOGLE_MAPS_API_KEY=
MAILBOX_MAX_SITES=0
MAILBOX_ENHANCEMENT_DEVICE=auto
MAILBOX_ENHANCEMENT_FP16=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2-vl
PREFER_LIVE_CADGIS=false

# Agent 4a house-boundary vision (GPT via Azure AI Foundry Responses API)
VISION_PROVIDER=azure_responses
AZURE_RESPONSES_ENDPOINT=
AZURE_RESPONSES_MODEL=gpt-4.1-mini
AZURE_RESPONSES_API_KEY=

# Optional override; Agent 4b uses its bundled fine-tuned RF-DETR Large weights by default
# RFDETR_LARGE_CHECKPOINT=C:\path\to\checkpoint_best_total.pth

# API endpoints and timeouts
BEST_API_BASE_URL=https://best.pr.fedservices.be/api/opendata/best/v1/belgianAddress/v2
BEST_API_TIMEOUT_SEC=45
CADGIS_TIMEOUT_SEC=60

# Shared external API cache (30 days)
POSTGRES_DB=mailbox_cache
POSTGRES_USER=mailbox
POSTGRES_PASSWORD=mailbox_cache
POSTGRES_PORT=15435
REDIS_PORT=16379
DATABASE_URL=postgresql://mailbox:mailbox_cache@127.0.0.1:15435/mailbox_cache
REDIS_URL=redis://127.0.0.1:16379/0
API_CACHE_TTL_SECONDS=2592000

# Web server
PORT=8002
BIND_HOST=0.0.0.0
# PUBLIC_HOST=mailbox-studio.local
